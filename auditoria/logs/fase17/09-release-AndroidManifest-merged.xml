<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.admilsonlandim.veyra"
    android:versionCode="1"
    android:versionName="1.0.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="37" />

    <!-- Android 13+ (API 33): granular audio permission. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!--
         No READ_MEDIA_IMAGES: Google Play only allows it when broad photo access is the app's core
         use, which finding covers is not. On Android 13+ covers therefore come only from the
         files themselves.
    -->
    <!-- Android 12L and earlier: broad storage read access (audio, and images for covers). -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
         Android 10 and older: needed to delete a track's file (Phase 14). Android 11+ asks the
         user through a MediaStore trash request instead, so it is never requested there.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- PlaybackService runs as a media playback foreground service while music plays. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Keeps the CPU awake while playing with the screen off (ExoPlayer wake mode). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
         Special app-op permission, granted by the user in system settings, needed to set the
         device ringtone / notification / alarm sound.
    -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!--
         Android 11+ package visibility: lets the app check whether the device has a system
         sound effects panel before offering to open it (Settings > Sound).
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
        </intent>
    </queries>

    <permission
        android:name="io.github.admilsonlandim.veyra.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="io.github.admilsonlandim.veyra.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />
    <!--
 requestLegacyExternalStorage only has an effect on Android 10 (ignored from 11): there,
         deleting another app's file through MediaStore with the system's per-file grant removes
         the library entry but leaves the file on disk (MediaProvider's own access check fails),
         so the file would come back at the next scan. Legacy storage deletes it, as on Android 9.
    -->
    <application
        android:name="io.github.admilsonlandim.veyra.VeyraApplication"
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:extractNativeLibs="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/_generated_res_locale_config"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Veyra" >
        <activity
            android:name="io.github.admilsonlandim.veyra.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Veyra"
            android:windowSoftInputMode="adjustResize" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
             Exported so system UI, Bluetooth and other controllers can connect; MediaSession
             decides which controllers to accept (MediaSession.Callback.onConnect).
        -->
        <service
            android:name="io.github.admilsonlandim.veyra.playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback" >
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!--
             Android 12 and older: AppCompat stores the per-app language chosen in Settings and
             restores it at start-up (Android 13+ keeps it in the system instead).
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false" >
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
        <!-- TODO: b/510644544 - Remove this workaround once minSdk is 38 -->
        <activity
            android:name="androidx.media3.session.BluetoothValidationActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="android.permission.BLUETOOTH_PRIVILEGED"
            android:theme="@android:style/Theme.NoDisplay" >
            <intent-filter>

                <!-- Omit CATEGORY_DEFAULT to avoid listing this app as a generic audio app. -->
                <action android:name="android.intent.action.VIEW" />

                <data android:scheme="content" />
                <data android:host="media" />
                <!-- Satisfies the probe used in Bluetooths's MediaPlayerList.java on API 36 and 37. -->
                <data android:pathPrefix="/internal/audio/media/" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="io.github.admilsonlandim.veyra.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <uses-library
            android:name="androidx.window.extensions"
            android:required="false" />
        <uses-library
            android:name="androidx.window.sidecar"
            android:required="false" />

        <service
            android:name="androidx.room.MultiInstanceInvalidationService"
            android:directBootAware="true"
            android:exported="false" />

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>