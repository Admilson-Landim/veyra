<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- AppCompat (needed for per-app language on Android 12 and older). Compose draws the UI;
         this only sets the window behind it, so the app never flashes the wrong colour. -->
    <style name="Theme.Veyra" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/veyra_window</item>
        <item name="android:colorBackground">@color/veyra_window</item>
    </style>
</resources>
