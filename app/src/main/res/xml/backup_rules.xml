<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup on Android 11 and older (android:fullBackupContent); Android 12+ uses
    data_extraction_rules.xml instead. Same content and reasons as there: the database and the
    settings only, never caches or temporary files.
-->
<full-backup-content>
    <include domain="database" path="veyra.db" />
    <include domain="database" path="veyra.db-wal" />
    <include domain="database" path="veyra.db-shm" />
    <include domain="file" path="datastore/settings.preferences_pb" />
</full-backup-content>
