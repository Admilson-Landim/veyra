<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 13+ (API 33): granular audio permission. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- No READ_MEDIA_IMAGES: Google Play only allows it when broad photo access is the app's core
         use, which finding covers is not. On Android 13+ covers therefore come only from the
         files themselves. -->
    <!-- Android 12L and earlier: broad storage read access (audio, and images for covers). -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Android 10 and older: needed to delete a track's file (Phase 14). Android 11+ asks the
         user through a MediaStore trash request instead, so it is never requested there. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- PlaybackService runs as a media playback foreground service while music plays. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Keeps the CPU awake while playing with the screen off (ExoPlayer wake mode). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Special app-op permission, granted by the user in system settings, needed to set the
         device ringtone / notification / alarm sound. -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ package visibility: lets the app check whether the device has a system
         sound effects panel before offering to open it (Settings > Sound). -->
    <queries>
        <intent>
            <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
        </intent>
    </queries>

    <!-- requestLegacyExternalStorage only has an effect on Android 10 (ignored from 11): there,
         deleting another app's file through MediaStore with the system's per-file grant removes
         the library entry but leaves the file on disk (MediaProvider's own access check fails),
         so the file would come back at the next scan. Legacy storage deletes it, as on Android 9. -->
    <application
        android:name=".VeyraApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Veyra">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Veyra"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Exported so system UI, Bluetooth and other controllers can connect; MediaSession
             decides which controllers to accept (MediaSession.Callback.onConnect). -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Android 12 and older: AppCompat stores the per-app language chosen in Settings and
             restores it at start-up (Android 13+ keeps it in the system instead). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>